# Copy this file to .env and fill in real values. Never commit the real .env.

APP_NAME="okDriver CCTV Monitoring Platform"
ENVIRONMENT=development

# PostgreSQL (RDS-compatible). SQLite works for a zero-setup local run:
#   DATABASE_URL=sqlite:///./okdriver.db
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/okdriver
AUTO_CREATE_TABLES=true

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=gAQ5ee1v__SLcsp0Tdp5PRMnuLhXuUpktjawF_OL7BC7gPZ2rqUeeYlHiSk-hLJh
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Fernet key used to encrypt camera stream URLs/credentials at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=T9_da7JkDjO62Z9SpayRllT8AnmlxtxgebXyuxFAeBQ=

# Optional: enables the Redis Pub/Sub backplane so real-time events fan out
# across multiple backend replicas. Leave unset to run a single instance
# with in-process WebSocket broadcast.
REDIS_URL=redis://localhost:6379/0

CORS_ORIGINS=http://localhost:5173,http://localhost:3000

ENABLE_ANALYTICS_SIMULATOR=true
ANALYTICS_EVENT_INTERVAL_SECONDS=6
ENABLE_HEARTBEAT_SERVICE=true
HEARTBEAT_INTERVAL_SECONDS=8
EVENT_DEDUP_WINDOW_SECONDS=10

RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_INGEST=120/minute

# Seeded on first startup. Change these before any non-local deployment.
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=Admin@12345
DEFAULT_OPERATOR_USERNAME=operator
DEFAULT_OPERATOR_PASSWORD=Operator@12345
